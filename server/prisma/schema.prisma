generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  globeRadius Float    @default(5.0)
  texture     String   @default("earth")
  seed        Int      @default(0)
  terrainType String   @default("default")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LanternLedger {
  id        String   @id @default(cuid())
  count     Int
  worldSlug String
  createdAt DateTime @default(now())
}
